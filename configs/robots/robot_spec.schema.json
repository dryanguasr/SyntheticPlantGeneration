          "joint": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "continuous_effort": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Effective effort at the joint output, after transmission and efficiency; not motor stall torque."
          },
          "peak_effort": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Effective peak effort at the joint output; does not replace continuous effort."
          },
          "transmission_ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "efficiency": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "enum": [
              "medido",
              "derivado_de_CAD",
              "ficha_tecnica",
              "estimado",
              "pendiente"
            ]
          },
          "effort_reference": {
            "enum": [
              "joint_output"
            ],
            "description": "Declared effective joint-output effort; motor-shaft ratings require a separate documented transmission/efficiency conversion."
          }
