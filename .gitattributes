* text=auto

# Source and documentation use stable LF endings across platforms.
*.py text eol=lf
*.md text eol=lf whitespace=-trailing-space,-blank-at-eof
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.bib text eol=lf
*.ps1 text eol=crlf

# Scientific references and visual assets are binary.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.blend binary
